# Copie para .env e preencha. O .env NUNCA vai para o git.
# No Render, cadastre as mesmas variáveis em Environment (o render.yaml já lista todas).

# Postgres (Neon, Supabase...): string de conexão completa
DATABASE_URL=

# Texto aleatório e longo, usado para guardar o IP só como hash no rate limit
SAL_IP=

# ---------- Login e painel ----------
# E-mail de quem administra o painel. Ninguém consegue se cadastrar com ele. Primeiro acesso:
# entrar com esse e-mail e a ADMIN_SENHA_INICIAL (o site obriga a criar outra senha na hora),
# ou "Esqueci minha senha" (precisa do Resend configurado).
ADMIN_EMAIL=
# Nome do admin como aparece no agendamento
ADMIN_NOME=Dantas
# Senha provisória do primeiro acesso do admin (pelo menos 8 caracteres). Depois do primeiro acesso pode apagar.
ADMIN_SENHA_INICIAL=

# Endereço do site, usado no link de "Esqueci minha senha" (no Render: https://<nome>.onrender.com)
SITE_URL=

# ---------- E-mail (Resend: resend.com > API Keys) ----------
RESEND_API_KEY=
# Remetente. Sem domínio próprio verificado no Resend, use "Império Dantas <onboarding@resend.dev>"
# (aí o Resend só entrega no e-mail de quem criou a conta do Resend, bom para testar).
EMAIL_REMETENTE=Império Dantas <onboarding@resend.dev>
